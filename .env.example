# Riot Games API Credentials (Server-only, NEVER expose to client)
RIOT_API_KEY=
RIOT_API_ENABLED=false
RIOT_API_TIMEOUT_MS=8000

# Concurrency limit for PUUID -> Riot ID resolution (Default: 3)
RIOT_ACCOUNT_RESOLUTION_CONCURRENCY=3

# Optional Redis Cache (Fallback to In-Memory if not configured)
REDIS_URL=

# Optional CommunityDragon Version Pinning (Default: 18.3)
CDRAGON_VERSION=18.3
