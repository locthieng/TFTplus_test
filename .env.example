# Riot Games API Credentials (Server-only, NEVER expose to client)
RIOT_API_KEY=
RIOT_API_ENABLED=false
RIOT_API_TIMEOUT_MS=8000

# Concurrency limit for PUUID -> Riot ID resolution (Default: 3)
RIOT_ACCOUNT_RESOLUTION_CONCURRENCY=3

# Redis Cache (Upstash REST API or Vercel KV REST; falls back to In-Memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# CommunityDragon Static Data Source Configuration (Default: 16.19)
CDRAGON_SOURCE_VERSION=16.19
